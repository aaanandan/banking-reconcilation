# Banking Reconciliation Platform - Environment Variables
# Step 226: Slack Notification Configuration
# Copy this file to .env and fill in real values

# ── Slack Configuration ─────────────────────────────────────────────────────
# Create a Slack App at https://api.slack.com/apps
# Add an Incoming Webhook and copy the URL below
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK

# Required Slack channels (create these in your workspace):
#   #alerts-general   — fallback for all alerts
#   #alerts-critical  — critical severity alerts (immediate)
#   #alerts-warning   — warning severity alerts (batched)
#   #alerts-info      — info severity alerts (daily digest)
#   #security-alerts  — security category alerts
#   #business-alerts  — business category alerts

# ── Database ────────────────────────────────────────────────────────────────
POSTGRES_DB=banking_reconciliation
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_dev_password

# ── Auth Service ────────────────────────────────────────────────────────────
AUTH_SERVICE_PORT=3001
NODE_ENV=development
