{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/banking-reconciliation-system/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": false,
    "tsConfigPath": "apps/banking-reconciliation-system/tsconfig.app.json"
  },
  "monorepo": true,
  "root": "apps/banking-reconciliation-system",
  "projects": {
    "data-prep-service": {
      "type": "application",
      "root": "apps/data-prep-service",
      "entryFile": "main",
      "sourceRoot": "apps/data-prep-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/data-prep-service/tsconfig.app.json"
      }
    },
    "shared": {
      "type": "library",
      "root": "libs/shared",
      "entryFile": "index",
      "sourceRoot": "libs/shared/src",
      "compilerOptions": {
        "tsConfigPath": "libs/shared/tsconfig.lib.json"
      }
    },
    "state-manager-service": {
      "type": "application",
      "root": "apps/state-manager-service",
      "entryFile": "main",
      "sourceRoot": "apps/state-manager-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/state-manager-service/tsconfig.app.json"
      }
    }
  }
}