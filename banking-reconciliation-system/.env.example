# Environment Configuration
NODE_ENV=development # development | test | staging | production

# Application Ports
PORT=3000
AUTH_SERVICE_PORT=3001

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your_db_password_here
DB_DATABASE=banking_reconciliation

# JWT Configuration
JWT_SECRET=your-jwt-secret-key-change-in-production-min-32-chars
JWT_EXPIRATION=15m # Access token expiration
REFRESH_TOKEN_EXPIRATION=7d # Refresh token expiration

# Session Configuration
SESSION_SECRET=your-session-secret-key-change-in-production

# Security & CORS Configuration
# Comma-separated list of allowed origins for CORS
# Use '*' to allow all origins (NOT recommended for production)
# Examples:
#   Development: http://localhost:3000,http://localhost:4200
#   Production: https://app.yourdomain.com,https://admin.yourdomain.com
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:4200,http://localhost:8080

# OAuth Configuration
# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Microsoft OAuth
MICROSOFT_CLIENT_ID=your-microsoft-client-id
MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret
MICROSOFT_TENANT_ID=common # or your specific tenant ID

# Email Configuration (for verification, password reset, etc.)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-email-password-or-app-password
EMAIL_FROM=noreply@yourcompany.com

# Frontend URL (for email links, OAuth redirects)
FRONTEND_URL=http://localhost:4200

# Rate Limiting
THROTTLE_TTL=60 # Time to live in seconds
THROTTLE_LIMIT=10 # Max requests per TTL

# Logging
LOG_LEVEL=info # error | warn | info | debug | verbose

# API Documentation
SWAGGER_ENABLED=true # Enable Swagger API documentation

# AWS Configuration (for future cloud deployment)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key

# Redis Configuration (for session storage, caching - optional)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Sentry Configuration (for error tracking - optional)
SENTRY_DSN=

# Feature Flags
ENABLE_2FA=true
ENABLE_EMAIL_VERIFICATION=true
ENABLE_OAUTH=true
ENABLE_API_KEYS=true

# Monitoring & Health Checks
HEALTH_CHECK_ENDPOINT=/health
METRICS_ENDPOINT=/metrics

# File Upload Configuration
MAX_FILE_SIZE=10485760 # 10MB in bytes
ALLOWED_FILE_TYPES=.csv,.xlsx,.xls

# Tenant Configuration
DEFAULT_TENANT_ID=
MULTI_TENANT_ENABLED=true

# Security Headers
# Additional custom security configuration (optional)
HSTS_MAX_AGE=31536000 # 1 year in seconds
CSP_REPORT_URI= # URI to report CSP violations

# Backup Configuration
BACKUP_ENABLED=false
BACKUP_CRON=0 0 * * * # Daily at midnight

# Development Tools
ENABLE_DEBUG_LOGGING=false
ENABLE_QUERY_LOGGING=false
